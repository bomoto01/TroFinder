# ==========================================
# TROFINDER ENVIRONMENT TEMPLATE (.env.example)
# Sao chep file nay thanh .env va dien thong tin that
# ==========================================

# Database MySQL
DB_URL=jdbc:mysql://localhost:3306/trofinder?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Security & JWT
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
